{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@misub/core": ["packages/core/src/index.ts"],
      "@misub/core/*": ["packages/core/src/*"]
    }
  },
  "include": [
    "types/**/*.d.ts",
    "packages/core/src/**/*.ts",
    "functions/**/*.ts",
    "worker.ts",
    "src/**/*.ts",
    "src/**/*.vue"
  ],
  "exclude": ["node_modules", "dist", ".wrangler"]
}
