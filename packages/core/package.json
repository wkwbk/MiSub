    "./protocols/*": "./src/protocols/*",
    "./node": "./src/node/index.ts",
    "./node/*.js": "./src/node/*.ts",
    "./node/*": "./src/node/*",
    "./operators": "./src/operators/index.ts",
    "./operators/*.js": "./src/operators/*.ts",
    "./operators/*": "./src/operators/*",
    "./domain/*.js": "./src/domain/*.ts",
    "./domain/*": "./src/domain/*",
