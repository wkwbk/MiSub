{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@misub/core": ["packages/core/src/index.js"],
      "@misub/core/*": ["packages/core/src/*"]
    }
  },
  "include": ["types/**/*", "src/**/*", "packages/core/src/**/*", "functions/**/*", "worker.js", "tests/**/*"],
  "exclude": ["node_modules", "dist", ".wrangler"]
}
