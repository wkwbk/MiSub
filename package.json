{
  "name": "misub",
  "version": "2.8.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npx wrangler dev --port 8787",
    "deploy:worker": "npx wrangler deploy",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "vite build && playwright test",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit",
    "release": "node scripts/release.mjs",
    "format": "prettier --write \"functions/**/*.ts\" \"worker.ts\" \"packages/core/**/*.ts\" \"src/**/*.{ts,vue}\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"functions/**/*.ts\" \"worker.ts\" \"packages/core/**/*.ts\" \"src/**/*.{ts,vue}\" \"tests/**/*.js\""
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@lucide/vue": "^1.73.0",
    "@misub/core": "workspace:*",
    "@tanstack/vue-query": "^5.108.4",
    "dompurify": "3.4.5",
    "hono": "^4.13.21",
    "js-yaml": "^5.5.0",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "vuedraggable": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.162.0"
  }
}
