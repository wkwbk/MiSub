{
  "name": "misub",
  "version": "2.8.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npx wrangler dev --port 8787",
    "deploy:worker": "npx wrangler deploy",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "oxlint",
    "format": "prettier --write \"functions/**/*.js\" \"shared/**/*.js\" \"src/**/*.{js,vue}\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"functions/**/*.js\" \"shared/**/*.js\" \"src/**/*.{js,vue}\" \"tests/**/*.js\""
  },
  "dependencies": {
    "@lucide/vue": "^1.73.0",
    "dompurify": "3.4.5",
    "js-yaml": "^5.5.0",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
